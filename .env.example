# Keep real values in an untracked .env file or a secrets manager.
# The application does not read this file automatically at this stage.

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
DATABASE_URL=sqlite+aiosqlite:///data/theater_tickets.sqlite3

# No network request or ticket operation is enabled by this setting alone.
BOOKING_MODE=dry_run
POLL_INTERVAL_SECONDS=60
RENEWAL_INTERVAL_SECONDS=1200
EXPECTED_HOLD_TTL_SECONDS=1200
AVAILABILITY_RETRY_SECONDS=180

# Required only for a future explicitly authorized live checkout. Keep the JSON
# profile outside this repository, readable only by the service account.
BUYER_PROFILE_PATH=
